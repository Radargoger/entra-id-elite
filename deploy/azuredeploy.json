  "imports": {
    "microsoftGraphV1_0": {
      "provider": "MicrosoftGraph",
      "version": "1.0.0"
    }
  },
  "resources": {
    "storageAccount": {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[variables('storageAccountName')]",
      "location": "[variables('location')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "minimumTlsVersion": "TLS1_2",
        "allowBlobPublicAccess": false,
        "supportsHttpsTrafficOnly": true
      }
    },
    "tableService": {
      "type": "Microsoft.Storage/storageAccounts/tableServices",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}', variables('storageAccountName'), 'default')]",
      "dependsOn": [
        "storageAccount"
      ]
    },
    "stateTables": {
      "copy": {
        "name": "stateTables",
        "count": "[length(createArray('EntraIDState', 'FormerManual', 'FormerOwnership', 'LeakActionLedger'))]"
      },
      "type": "Microsoft.Storage/storageAccounts/tableServices/tables",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}/{2}', variables('storageAccountName'), 'default', createArray('EntraIDState', 'FormerManual', 'FormerOwnership', 'LeakActionLedger')[copyIndex()])]",
      "dependsOn": [
        "tableService"
      ]
    },
    "managedIdentity": {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[variables('managedIdentityName')]",
      "location": "[variables('location')]"
    },
    "appReg": {
      "condition": "[parameters('CreateAppRegistration')]",
      "import": "microsoftGraphV1_0",
      "type": "Microsoft.Graph/applications@v1.0",
      "properties": {
        "uniqueName": "[variables('graphUniqueAppName')]",
        "displayName": "Entra ID Elite",
        "signInAudience": "AzureADMultipleOrgs",
        "requiredResourceAccess": [
          {
            "copy": [
              {
                "name": "resourceAccess",
                "count": "[length(variables('eliteGraphRoleIds'))]",
                "input": {
                  "id": "[variables('eliteGraphRoleIds')[copyIndex('resourceAccess')]]",
                  "type": "Role"
                }
              }
            ],
            "resourceAppId": "00000003-0000-0000-c000-000000000000"
          }
        ]
      }
    },
    "appSp": {
      "condition": "[parameters('CreateAppRegistration')]",
      "import": "microsoftGraphV1_0",
      "type": "Microsoft.Graph/servicePrincipals@v1.0",
      "properties": {
        "appId": "[reference('appReg').appId]"
      },
      "dependsOn": [
        "appReg"
      ]
    },
    "fic": {
      "condition": "[parameters('CreateAppRegistration')]",
      "import": "microsoftGraphV1_0",
      "type": "Microsoft.Graph/applications/federatedIdentityCredentials@v1.0",
      "properties": {
        "name": "[format('{0}/former-elite-uami', reference('appReg').uniqueName)]",
        "audiences": [
          "api://AzureADTokenExchange"
        ],
        "issuer": "[format('https://login.microsoftonline.com/{0}/v2.0', tenant().tenantId)]",
        "subject": "[reference('managedIdentity').principalId]"
      },
      "dependsOn": [
        "appReg",
        "managedIdentity"
      ]
    },
    "graphSpRef": {
      "condition": "[and(parameters('CreateAppRegistration'), parameters('GrantAdminConsent'))]",
      "existing": true,
      "import": "microsoftGraphV1_0",
      "type": "Microsoft.Graph/servicePrincipals@v1.0",
      "properties": {
        "appId": "00000003-0000-0000-c000-000000000000"
      }
    },
    "adminConsentGrants": {
      "copy": {
        "name": "adminConsentGrants",
        "count": "[length(variables('readGraphRoleIds'))]"
      },
      "condition": "[and(parameters('CreateAppRegistration'), parameters('GrantAdminConsent'))]",
      "import": "microsoftGraphV1_0",
      "type": "Microsoft.Graph/appRoleAssignedTo@v1.0",
      "properties": {
        "appRoleId": "[variables('readGraphRoleIds')[copyIndex()]]",
        "principalId": "[reference('appSp').id]",
        "resourceId": "[reference('graphSpRef').id]"
      },
      "dependsOn": [
        "appSp",
        "graphSpRef"
      ]
    },
    "addFicToExistingApp": {
      "condition": "[and(not(parameters('CreateAppRegistration')), not(parameters('SkipFicCreation')))]",
      "type": "Microsoft.Resources/deploymentScripts",
      "apiVersion": "2020-10-01",
      "name": "[format('addFic-{0}', variables('suffix'))]",
      "location": "[variables('location')]",
      "kind": "AzureCLI",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('managedIdentityName')))]": {}
        }
      },
      "properties": {
        "azCliVersion": "2.50.0",
        "retentionInterval": "PT1H",
        "timeout": "PT5M",
        "environmentVariables": [
          {
            "name": "APP_ID",
            "value": "[parameters('EntraIdClientId')]"
          },
          {
            "name": "TENANT_ID",
            "value": "[subscription().tenantId]"
          },
          {
            "name": "UAMI_PRINCIPAL",
            "value": "[reference('managedIdentity').principalId]"
          },
          {
            "name": "RG_NAME",
            "value": "[resourceGroup().name]"
          }
        ],
        "scriptContent": "      FIC_NAME=\"former-elite-${RG_NAME}-uami\"\n      ADDED=false\n      EXISTING=$(az ad app federated-credential list --id \"$APP_ID\" --query \"[?subject=='${UAMI_PRINCIPAL}'].name\" -o tsv 2>/dev/null || echo \"\")\n      if [ -n \"$EXISTING\" ]; then\n        echo \"FIC already exists for UAMI ${UAMI_PRINCIPAL} on app ${APP_ID}: ${EXISTING}\"\n        ADDED=true\n      elif az ad app federated-credential create --id \"$APP_ID\" --parameters \"{\n          \\\"name\\\": \\\"${FIC_NAME}\\\",\n          \\\"issuer\\\": \\\"https://login.microsoftonline.com/${TENANT_ID}/v2.0\\\",\n          \\\"subject\\\": \\\"${UAMI_PRINCIPAL}\\\",\n          \\\"audiences\\\": [\\\"api://AzureADTokenExchange\\\"]\n        }\"; then\n        echo \"FIC added\"\n        ADDED=true\n      else\n        # Fail-soft: the deployment identity (UAMI) usually has no Entra\n        # app-write permission on a foreign App Registration. The app cannot\n        # run until the FIC exists, but failing the whole deployment here\n        # would strand the rest of the install. Surface the exact command.\n        echo \"WARNING: could not add FIC automatically (no Entra app-write permission).\"\n        echo \"Run the command from the deployment output 'ficManualCommand' as an owner of the App Registration.\"\n      fi\n      # Report what actually happened. The Outputs blade is the only place most\n      # operators look, so it must not claim a success the script did not\n      # achieve: without the FIC the app gets no Graph token and every directory\n      # lookup is skipped, quietly. Keep this JSON trivial -- quoting through\n      # bicep, ARM and the shell is a three-layer escaping trap, and a malformed\n      # output file fails the whole deployment.\n      if [ \"$ADDED\" = \"true\" ]; then\n        echo '{\"ficAdded\": true}' > \"$AZ_SCRIPTS_OUTPUT_PATH\"\n      else\n        echo '{\"ficAdded\": false}' > \"$AZ_SCRIPTS_OUTPUT_PATH\"\n      fi\n      exit 0\n    "
      },
      "dependsOn": [
        "managedIdentity"
      ]
    },
    "workspace": {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[variables('workspaceName')]",
      "location": "[variables('location')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 90
      }
