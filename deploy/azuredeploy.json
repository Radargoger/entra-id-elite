    "triggerFirstRun": {
      "condition": "[and(not(empty(parameters('PackageUri'))), parameters('RunOnStartup'))]",
      "type": "Microsoft.Resources/deploymentScripts",
      "apiVersion": "2020-10-01",
      "name": "[format('triggerFirstRun-{0}', variables('suffix'))]",
      "location": "[variables('location')]",
      "kind": "AzureCLI",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('managedIdentityName')))]": {}
        }
      },
      "properties": {
        "azCliVersion": "2.50.0",
        "retentionInterval": "PT1H",
        "timeout": "PT15M",
        "scriptContent": "set -euo pipefail; sleep 30 && az functionapp restart --name \"$FA_NAME\" --resource-group \"$RG_NAME\" && echo restarted",
        "environmentVariables": [
          {
            "name": "FA_NAME",
            "value": "[variables('functionAppName')]"
          },
          {
            "name": "RG_NAME",
            "value": "[resourceGroup().name]"
          }
        ]
      },
      "dependsOn": [
        "faContributorRole",
        "functionApp",
        "managedIdentity"
      ]
    },
    "faContributorRole": {
      "condition": "[and(not(empty(parameters('PackageUri'))), parameters('RunOnStartup'))]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.Web/sites', variables('functionAppName'))]",
      "name": "[guid(resourceId('Microsoft.Web/sites', variables('functionAppName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('managedIdentityName')), 'WebsiteContributor')]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'de139f84-1756-47ae-9be6-808fbbe84772')]",
        "principalId": "[reference('managedIdentity').principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "functionApp",
        "managedIdentity"
      ]
    }
  },
  "outputs": {
    "functionAppName": {
      "type": "string",
      "value": "[variables('functionAppName')]"
    },
    "previewUrl": {
      "type": "string",
      "value": "[format('https://{0}.azurewebsites.net/api/former/preview?code=<function-key>', variables('functionAppName'))]"
    },
    "entraClientId": {
      "type": "string",
      "value": "[if(parameters('CreateAppRegistration'), reference('appReg').appId, parameters('EntraIdClientId'))]"
    },
    "workspaceName": {
      "type": "string",
      "value": "[variables('workspaceName')]"
    },
    "consentNote": {
      "type": "string",
      "value": "[if(parameters('CreateAppRegistration'), if(parameters('GrantAdminConsent'), 'Consent granted by the deployment. Each sibling tenant still needs the multi-tenant app consented once.', 'Grant admin consent to the new App Registration (Entra portal > App registrations > Entra ID Elite > API permissions), and consent it in every sibling tenant.'), 'Not checked here: the deployment cannot read the permissions of an App Registration it does not own. Confirm the reused app still has its Graph permissions granted, and that each sibling tenant has consented to the multi-tenant app once.')]"
    },
    "ficNote": {
      "type": "string",
      "value": "[if(parameters('CreateAppRegistration'), 'FIC created automatically.', if(parameters('SkipFicCreation'), 'FIC skipped — add it manually for the UAMI principal.', if(reference('addFicToExistingApp').outputs.ficAdded, 'FIC is in place on the existing App Registration.', 'CHECK THIS — the deployment could not add the federated credential, and without Entra read permission it also cannot tell whether a suitable one already exists. Confirm with GET /api/former/preview: if snapshot_complete is false the credential is missing, and an owner of the App Registration must run the command in ficManualCommand. Do not use leak/preview for this: it reports no reachable tenant whenever leak monitoring is off, which is the default. Until then no user is looked up or acted on.')))]"
    },
    "ficManualCommand": {
      "type": "string",
      "value": "[if(or(parameters('CreateAppRegistration'), parameters('SkipFicCreation')), '', if(reference('addFicToExistingApp').outputs.ficAdded, '', format('az ad app federated-credential create --id {0} --parameters ''{{\"name\":\"former-elite-{1}-uami\",\"issuer\":\"https://login.microsoftonline.com/{2}/v2.0\",\"subject\":\"{3}\",\"audiences\":[\"api://AzureADTokenExchange\"]}}''', parameters('EntraIdClientId'), resourceGroup().name, subscription().tenantId, reference('managedIdentity').principalId)))]"
    }
  }
}