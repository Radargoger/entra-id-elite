    "formerSchedule": "[if(less(parameters('FormerSyncIntervalMinutes'), 60), format('0 */{0} * * * *', parameters('FormerSyncIntervalMinutes')), format('0 0 */{0} * * *', div(parameters('FormerSyncIntervalMinutes'), 60)))]",
    "graphUniqueAppName": "[format('entra-former-{0}', variables('suffix'))]",
    "readGraphRoleIds": [
      "df021288-bdef-4463-88db-98f22de89214"
    ],
    "respondOn": "[and(parameters('EnableLeakMonitoring'), equals(parameters('LeakResponse'), 'respond'))]",
    "actionGraphRoleIds": "[union(if(and(variables('respondOn'), contains(parameters('LeakResponseActions'), 'revokeSessions')), createArray('77f3a031-c388-4f99-b373-dc68676a979e'), createArray()), if(and(variables('respondOn'), contains(parameters('LeakResponseActions'), 'forcePasswordChange')), createArray('cc117bb9-00cf-4eb8-b580-ea2a878fe8f7'), createArray()), if(and(variables('respondOn'), contains(parameters('LeakResponseActions'), 'disableAccount')), createArray('3011c876-62b7-4ada-afa2-506cbbecc68c'), createArray()), if(and(variables('respondOn'), contains(parameters('LeakResponseActions'), 'resetMfa')), createArray('50483e42-d915-4231-9639-7fdb7fd190e5'), createArray()), if(and(variables('respondOn'), contains(parameters('LeakResponseActions'), 'confirmCompromised')), createArray('656f6061-f9fe-4807-9708-6a2e0934df76'), createArray()), if(and(variables('respondOn'), not(empty(parameters('SecurityGroupId')))), createArray('dbaae8cf-10b5-4b86-a4a1-f871c94c6695'), createArray()))]",
    "eliteGraphRoleIds": "[union(variables('readGraphRoleIds'), variables('actionGraphRoleIds'))]",
